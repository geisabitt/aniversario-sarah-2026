const SHEET = 'Página1';
function resposta(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON)}
function doGet(){const s=SpreadsheetApp.getActive().getSheetByName(SHEET);const a=s.getDataRange().getValues();return resposta(a.slice(1).filter(r=>r[0]&&r[1]).map(r=>({id:Number(r[0]),item:String(r[1]),status:String(r[2]||'Disponível'),nome:String(r[3]||''),imagem:String(r[4]||'')})))}
function doPost(e){const lock=LockService.getScriptLock();if(!lock.tryLock(10000))return resposta({success:false,erro:'Muitas escolhas ao mesmo tempo. Tente novamente.'});try{const d=JSON.parse(e.postData.contents);const id=Number(d.id),nome=String(d.nome||'').trim();if(!Number.isSafeInteger(id)||id<1||nome.length<2||nome.length>100)return resposta({success:false,erro:'Dados inválidos'});const s=SpreadsheetApp.getActive().getSheetByName(SHEET),rows=s.getDataRange().getValues();for(let i=1;i<rows.length;i++){if(Number(rows[i][0])===id){if(String(rows[i][2]||'Disponível')!=='Disponível')return resposta({success:false,erro:'Este item já foi escolhido. Escolha outro.'});s.getRange(i+1,3,1,2).setValues([['Escolhido',nome]]);SpreadsheetApp.flush();return resposta({success:true})}}return resposta({success:false,erro:'Item não encontrado'})}catch{return resposta({success:false,erro:'Erro ao reservar'})}finally{lock.releaseLock()}}
